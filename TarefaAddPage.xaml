<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TarefasApp.TarefaAddPage"
             Title="Adicionar">
    <ScrollView>
        <StackLayout Padding="20" Spacing="15">
            <Label Text="Título" />
            <Entry Text="{Binding Titulo}" Placeholder="Título da tarefa" />

            <Label Text="Descrição" />
            <Editor Text="{Binding Descricao}" AutoSize="TextChanges" HeightRequest="120" />

            <Label Text="Data de criação" />
            <DatePicker Date="{Binding DataCriacao}" />

            <Label Text="Prioridade" />
            <Picker Title="Prioridade" SelectedItem="{Binding Prioridade}">
                <Picker.Items>
                    <x:String>Baixa</x:String>
                    <x:String>Média</x:String>
                    <x:String>Alta</x:String>
                </Picker.Items>
            </Picker>

            <StackLayout Orientation="Horizontal" HorizontalOptions="Center" Spacing="20">
                <Button Text="Salvar" Clicked="OnSaveClicked" />
                <Button Text="Cancelar" Clicked="OnCancelClicked" />
            </StackLayout>
        </StackLayout>
    </ScrollView>
</ContentPage>
